# The public devnet RPC (api.devnet.solana.com) rate-limits hard (HTTP 429).
# For a live demo use a free devnet endpoint, e.g. Helius or QuickNode:
# VITE_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
VITE_RPC_URL=

# Where QR codes point. When presenting from localhost, set this to the deployed site so a
# phone scanning the QR opens the public app, e.g. https://jar-tips.vercel.app
VITE_PUBLIC_URL=
